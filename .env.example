# --- OpenRouter ---
OPENROUTER_API_KEY=

# Embedder. Asymmetric bi-encoder: passages and queries embed differently.
HOLYSTONE_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
# How to convey query/passage intent to the endpoint:
#   param  - send "input_type" in the request body (NIM-style; OpenRouter forwards provider params)
#   prefix - prepend "query: " / "passage: " to the text (E5-style fallback)
#   none   - send raw text (symmetric models)
# If retrieval quality looks bad with one mode, try the other.
HOLYSTONE_EMBED_INPUT_TYPE_MODE=param
HOLYSTONE_EMBED_BATCH_SIZE=32

# Condenser. Any current :free chat model with decent context works.
# Browse: https://openrouter.ai/models?max_price=0
HOLYSTONE_CONDENSER_MODEL=
HOLYSTONE_CONDENSER_TEMPERATURE=0.2

# Chunking (characters)
HOLYSTONE_CHUNK_CHARS=6000
HOLYSTONE_CONDENSE_WINDOW_CHARS=12000

# --- Postgres / Supabase ---
# Supabase: Project Settings -> Database -> Connection string (session pooler is fine)
DATABASE_URL=
